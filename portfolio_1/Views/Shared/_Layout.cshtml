@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    var editor = ctrl is "Courses" or "Projects" or "Images";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Portfolio</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar @(editor ? "editor" : "")">
        <div class="container d-flex align-items-center gap-3">
            <a class="brand" asp-controller="Home" asp-action="Index">Portfolio</a>
            @if (editor)
            {
                <span class="badge-editor">Editor</span>
            }
            <div class="ms-auto d-flex align-items-center gap-3">
                @if (editor)
                {
                    <a asp-controller="Courses" asp-action="Index">Courses</a>
                    <a asp-controller="Projects" asp-action="Index">Projects</a>
                    <a class="pill-btn" asp-controller="Home" asp-action="Index">View portfolio</a>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        <button class="linkbtn">Sign out</button>
                    </form>
                }
                else
                {
                    <a class="pill-btn" asp-controller="Projects" asp-action="Index">Edit portfolio</a>
                }
            </div>
        </div>
    </header>

    <main class="container py-4">
        @if (TempData["Ok"] is string ok)
        {
            <div class="alert alert-success">@ok</div>
        }
        @if (TempData["Error"] is string err)
        {
            <div class="alert alert-danger">@err</div>
        }
        @RenderBody()
    </main>

    <footer class="container sitefooter">Built with ASP.NET Core MVC and PostgreSQL</footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
