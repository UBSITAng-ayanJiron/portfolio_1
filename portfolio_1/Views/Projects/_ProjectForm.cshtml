@using portfolio.Models
@model ProjectForm
<form method="post" id="projectForm" style="max-width:640px">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="mb-3">
        <label asp-for="CourseId" class="form-label"></label>
        <select asp-for="CourseId" asp-items="@((SelectList)ViewBag.Courses)" class="form-select">
            <option value="0">— Choose a course —</option>
        </select>
        <span asp-validation-for="CourseId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="CompletedOn" class="form-label"></label>
        <input asp-for="CompletedOn" class="form-control" />
        <span asp-validation-for="CompletedOn" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="VideoUrl" class="form-label"></label>
        <input asp-for="VideoUrl" class="form-control" placeholder="https://youtu.be/xxxxxxxxxxx" />
        <span asp-validation-for="VideoUrl" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ImageUrls" class="form-label"></label>
        <textarea asp-for="ImageUrls" class="form-control" rows="5" placeholder="https://.../photo1.png&#10;https://.../photo2.png"></textarea>
        <span asp-validation-for="ImageUrls" class="text-danger"></span>
        <span id="imageUrlsClientError" class="text-danger"></span>
    </div>

    <button class="btn btn-primary">Save</button>
    <a class="btn btn-link" asp-action="Index">Cancel</a>
</form>

<script>
    // Browser check for the image list, line by line (the server checks again with Regex.IsMatch)
    document.getElementById("projectForm").addEventListener("submit", function (e) {
        var re = new RegExp(@Html.Raw(Json.Serialize(Patterns.ImageUrl)));
        var lines = document.getElementById("ImageUrls").value.split(/\r?\n/);
        var msg = document.getElementById("imageUrlsClientError");
        msg.textContent = "";
        for (var i = 0; i < lines.length; i++) {
            var line = lines[i].trim();
            if (line !== "" && !re.test(line)) {
                msg.textContent = "Image " + (i + 1) + " is not a valid URL (it must start with http:// or https://).";
                e.preventDefault();
                return;
            }
        }
    });
</script>